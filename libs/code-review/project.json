{
  "name": "code-review",
  "sourceRoot": "libs/code-review/src",
  "projectType": "library",
  "tags": ["scope:code-review", "type:tool"],
  "targets": {
    "review": {
      "executor": "nx:run-commands",
      "options": { "command": "yarn review", "cwd": "libs/code-review" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "yarn build", "cwd": "libs/code-review" }
    },
    "validate": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "yarn validate", "cwd": "libs/code-review" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "yarn test", "cwd": "libs/code-review" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "yarn lint", "cwd": "libs/code-review" }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": { "command": "yarn lint:fix", "cwd": "libs/code-review" }
    },
    "ts-check": {
      "executor": "nx:run-commands",
      "options": { "command": "yarn ts-check", "cwd": "libs/code-review" }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": { "command": "yarn clean", "cwd": "libs/code-review" }
    },
    "publish:pkg": {
      "executor": "nx:run-commands",
      "options": { "command": "yarn publish:pkg", "cwd": "libs/code-review" }
    },
    "publish:beta": {
      "executor": "nx:run-commands",
      "options": { "command": "yarn publish:beta", "cwd": "libs/code-review" }
    }
  }
}
