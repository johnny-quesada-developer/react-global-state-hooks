{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2017", "DOM"],
    "outDir": "./",
    "declarationDir": "./",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["jest", "node", "react"],
    "typeRoots": ["../../node_modules/@types", "./types"],
    "baseUrl": "."
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["node_modules", "lib", "__test__"]
}
