{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "chrome"],
    "baseUrl": ".",
    "paths": {
      "react-global-state-hooks": ["../web/src/index.ts"],
      "react-global-state-hooks/*": ["../web/src/*"],
      "react-hooks-global-states": ["../universal/src/index.ts"],
      "react-hooks-global-states/*": ["../universal/src/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
