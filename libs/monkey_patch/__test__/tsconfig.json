{
  // `ts-check:tests` uses this config to type-check the patched-run HARNESS: monkey_patch's own
  // src plus the Vitest workspace/config/setup files that wire the reusable suite under the debug
  // patch. It adds the `react` + `vitest/globals` types (the main tsconfig pulls only
  // node/chrome) and turns off unused checks for tests.
  //
  // It does NOT type-check the reusable suites (test/universal, test/web, test/native): each of
  // those is type-checked by the variant lib that owns its subject (universal/web/mobile's
  // `ts-check:tests`), against the correct `global-state-hooks-under-test` -> variant mapping. A
  // single tsconfig here could only bind that neutral alias to ONE variant, which would wrongly
  // reject the other variants' variant-specific APIs (e.g. the native `asyncStorage` config).
  //
  // It also does NOT type-check monkey_patch's OWN unit tests (__test__/*.test.ts): they predate
  // this config and carry branded-id fixtures written as plain strings (correct at runtime, not
  // brand-typed). Bringing them under tsc is tracked separately.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // The base config's `typeRoots` only covers `@types`, which prevents TS from finding
    // `vitest/globals` (it lives at `node_modules/vitest`). Include the plain `node_modules`
    // root here so the vitest globals types resolve.
    "typeRoots": ["../../../node_modules/@types", "../../../node_modules"],
    "types": ["node", "chrome", "vitest/globals", "react"],
    "paths": {
      // The base package + own-name aliases mirror the runtime workspace aliases so the harness
      // files (which import from `react-global-state-hooks`) type-check.
      "react-global-state-hooks": ["../web/src/index.ts"],
      "react-global-state-hooks/*": ["../web/src/*"],
      "react-hooks-global-states": ["../universal/src/index.ts"],
      "react-hooks-global-states/*": ["../universal/src/*"]
    }
  },
  "include": [
    "../src/**/*",
    "../vitest.config.ts",
    "../vitest.workspace.ts",
    "../vitest.setup.ts",
    "../vitest.setup.patched.ts",
    "../vitest.setup.patched.native.ts",
    "../../test/helpers/**/*"
  ],
  "exclude": []
}
