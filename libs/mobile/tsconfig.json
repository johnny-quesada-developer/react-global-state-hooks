{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017", "DOM"],
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./",
    "declarationDir": "./",
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types", "./types"],
    "baseUrl": ".",
    "paths": {
      "react-hooks-global-states": ["../universal/src/index.ts"],
      "react-hooks-global-states/*": ["../universal/src/*"],
      "*": ["src/*"]
    }
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["node_modules", "lib"]
}
