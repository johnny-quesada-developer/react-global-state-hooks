{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2016",
    "lib": ["es2016"],
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./",
    "declarationDir": "./",
    "types": ["jest", "node"],
    "typeRoots": ["../../node_modules/@types", "./types"],
    "baseUrl": ".",
    "paths": {
      "*": ["src/*"]
    }
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["node_modules", "lib"]
}
