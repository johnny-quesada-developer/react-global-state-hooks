{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./",
    "declarationDir": "./",
    "types": ["node", "react"],
    "typeRoots": ["../../node_modules/@types", "./types"],
    "baseUrl": ".",
    "paths": {
      "react-hooks-global-states": ["../universal/src/index.ts"],
      "react-hooks-global-states/*": ["../universal/src/*"],
      "*": ["src/*"]
    }
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["node_modules", "lib"]
}
