{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true,
    // `bundler` resolution lets TS read vitest's `exports` map for its `globals` types; it
    // requires an ES module setting. This config only type-checks (noEmit), so overriding
    // `module` here is safe and does not affect the build.
    "module": "esnext",
    "moduleResolution": "bundler",
    // The parent config's `typeRoots` only covers `@types` + local `./types`, which prevents
    // TS from finding `vitest/globals` (it lives at `node_modules/vitest`). Include the plain
    // `node_modules` root here so the vitest globals types resolve.
    "typeRoots": ["../../../node_modules/@types", "../../../node_modules", "../types"],
    "types": ["vitest/globals", "node", "react"],
    "paths": {
      "react-global-state-hooks": ["./src"],
      "react-global-state-hooks/*": ["./src/*"],
      "global-state-hooks-under-test": ["./src"],
      "global-state-hooks-under-test/*": ["./src/*"],
      "react-hooks-global-states": ["../universal/src/index.ts"],
      "react-hooks-global-states/*": ["../universal/src/*"]
    }
  },
  "include": ["**/*", "../src/**/*", "../types/**/*", "../../shared-tests/**/*"],
  "exclude": []
}
