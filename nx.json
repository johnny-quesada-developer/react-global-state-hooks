{
  "//": "Serialize builds: web/mobile declarations read universal/dist, which its build replaces.",
  "parallel": 1,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/__test__/**/*",
      "!{projectRoot}/**/*.test.{ts,tsx}",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/vitest.setup.ts"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mts",
      "{workspaceRoot}/.prettierrc"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["production", "^production", "{workspaceRoot}/scripts/prepare-dist.ts"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "//": "Tests resolve source; built-package compatibility is checked by test:interop.",
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test:quick": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "test:coverage": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/eslint.config.mts"]
    },
    "lint:fix": {
      "cache": false,
      "inputs": ["default", "{workspaceRoot}/eslint.config.mts"]
    },
    "ts-check": {
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "ts-check:tests": {
      "cache": true,
      "inputs": ["default", "^production"]
    }
  },
  "analytics": false
}
