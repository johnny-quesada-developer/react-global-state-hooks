# Public site configuration. Committed on purpose: this is an open-source project and nothing here is
# secret. Only PUBLIC_* variables are exposed to the site (Astro/Vite bake them in at build time).
# Read through src/lib/site.ts; astro.config.mjs reads the site URL and base path from here too.

# Deployment (GitHub Pages project site: https://johnny-quesada-developer.github.io/react-global-state-hooks/)
PUBLIC_SITE_URL=https://johnny-quesada-developer.github.io
PUBLIC_BASE_PATH=/react-global-state-hooks

PUBLIC_SITE_NAME=react-global-state-hooks

# The library version these docs and examples describe (workspace source).
PUBLIC_PACKAGE_VERSION=16.0.5

# External links
PUBLIC_REPO_URL=https://github.com/johnny-quesada-developer/react-global-state-hooks
PUBLIC_NPM_URL=https://www.npmjs.com/package/react-global-state-hooks
PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/bafojplmkpejhglhjpibpdhoblickpee
PUBLIC_LIVE_DEMO_URL=https://johnny-quesada-developer.github.io/global-hooks-example/
PUBLIC_VIDEO_TUTORIAL_URL=https://www.youtube.com/watch?v=1UBqXk2MH8I
PUBLIC_EASY_WEB_WORKER_URL=https://github.com/johnny-quesada-developer/easy-web-worker
PUBLIC_JSON_STORAGE_FORMATTER_URL=https://github.com/johnny-quesada-developer/json-storage-formatter
PUBLIC_GITHUB_PROFILE_URL=https://github.com/johnny-quesada-developer
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/quesada-react-angular-typescript-developer/
