---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DocsHub } from '../../ui/docs/DocsHub';
import { getDocsNav } from '../../lib/docs';

const { sections } = await getDocsNav();
const hubSections = sections.map((section) => ({
  title: section.title,
  pages: section.pages.map((page) => ({ id: page.id, title: page.data.title, description: page.data.description })),
}));
---

<BaseLayout
  image="og/docs.png"
  imageAlt="react-global-state-hooks documentation"
  title="React state management documentation"
  description="Learn shared React state, selectors, async actions, localStorage persistence, and DevTools with react-global-state-hooks guides and API reference."
>
  <DocsHub sections={hubSections} />
</BaseLayout>
