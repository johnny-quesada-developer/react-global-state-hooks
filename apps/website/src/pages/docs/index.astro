---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DocsIndex } from '../../ui/DocsIndex';
import { getDocsNav } from '../../lib/docs';

const { sections } = await getDocsNav();
const indexSections = sections.map((section) => ({
  title: section.title,
  pages: section.pages.map((page) => ({
    id: page.id,
    title: page.data.title,
    description: page.data.description,
  })),
}));
---

<BaseLayout
  title="Documentation"
  description="Guides and reference for react-global-state-hooks: install, create stores, select state, add actions, persist and test."
>
  <DocsIndex sections={indexSections} />
</BaseLayout>
