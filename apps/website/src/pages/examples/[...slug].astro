---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ExamplePage } from '../../ui/ExamplePage';
import { H2, H3 } from '../../ui/Heading';

export async function getStaticPaths() {
  const entries = (await getCollection('examples')).sort((a, b) => a.data.order - b.data.order);

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previous: entries[index - 1] && { id: entries[index - 1].id, title: entries[index - 1].data.title },
      next: entries[index + 1] && { id: entries[index + 1].id, title: entries[index + 1].data.title },
    },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  image={`og/examples/${entry.id}.png`}
  imageAlt={`${entry.data.title}, react-global-state-hooks example`}
>
  <ExamplePage
    title={entry.data.title}
    description={entry.data.description}
    related={entry.data.related}
    previous={previous}
    next={next}
  >
    <Content components={{ h2: H2, h3: H3 }} />
  </ExamplePage>
</BaseLayout>
