{
  "compilerOptions": {
    "target": "es2020",
    "useDefineForClassFields": true,
    "lib": ["es2016", "es2021", "DOM", "DOM.Iterable"],
    "noImplicitAny": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["./src/*"],
      "@assets/*": ["./src/assets/*"],
      "@shared/*": ["./src/shared/*"],
      "@shared": ["./src/shared/index.ts"],
      "@pages/*": ["./src/pages/*"],
      "@pages/shared": ["./src/pages/shared/index.ts"],
      "@pages/shared/*": ["./src/pages/shared/*"],
      "@main_tab": ["./src/pages/main_tab/index.ts"],
      "@main_tab/*": ["./src/pages/main_tab/*"],

      // Monorepo source aliases (mirror vite.config.ts). Subpaths before bare barrels.
      "react-global-state-hooks": ["../../libs/web/src/index.ts"],
      "react-global-state-hooks/*": ["../../libs/web/src/*"],
      "react-hooks-global-states-debug": ["../../libs/monkey_patch/src/debug.ts"],
      "react-hooks-global-states-debug/*": ["../../libs/monkey_patch/src/*"],
      "react-hooks-global-states": ["../../libs/universal/src/index.ts"],
      "react-hooks-global-states/*": ["../../libs/universal/src/*"]
    },
    "types": ["chrome"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"],
  "exclude": ["src/__tests__", "**/__tests__", "**/*.test.ts", "**/*.test.tsx", "node_modules"]
}
