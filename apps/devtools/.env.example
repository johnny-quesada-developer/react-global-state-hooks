# DevTools panel local preview configuration.
#
# These VITE_-prefixed vars are exposed to client code via import.meta.env.
# Copy this file to `.env` to set defaults, or pass them ad-hoc (the
# `yarn preview:dev [example]` script sets VITE_MOCK_EXAMPLE for you).

# Mock example seeded into the local preview page (index.local.html).
# Known values: devtools | dev | todolist | todo | todos
# Unknown/empty values fall back to 'devtools'.
VITE_MOCK_EXAMPLE=devtools
