{
  "compilerOptions": {
    "target": "es2020",
    "useDefineForClassFields": true,
    "lib": ["es2016", "es2021", "DOM", "DOM.Iterable"],
    "noImplicitAny": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@src/*": ["./src/*"],
      "@assets/*": ["./src/assets/*"],
      "@shared/*": ["./src/shared/*"],
      "@shared": ["./src/shared/index.ts"],

      // pages
      "@pages/*": ["./src/pages/*"],
      "@pages/shared": ["./src/pages/shared/index.ts"],
      "@pages/shared/*": ["./src/pages/shared/*"],

      // main_tab
      "@main_tab": ["./src/pages/main_tab/index.ts"],
      "@main_tab/*": ["./src/pages/main_tab/*"]
    },
    "types": ["chrome"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src",
    "playground/src/__tests__/react-global-state-hooks",
    "playground/src/__tests__/react-hooks-global-states"
  ],
  "exclude": ["src/__tests__", "**/__tests__", "node_modules"]
}
