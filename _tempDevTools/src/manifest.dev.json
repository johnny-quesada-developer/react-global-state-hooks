{
  "manifest_version": 2,
  "name": "React Hooks Global States Dev Tools (Dev)",
  "version": "1.0",
  "permissions": [],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/content_script.js"],
      "run_at": "document_start"
    }
  ],
  "devtools_page": "devtools_page.html",
  "icons": {
    "16": "assets/devtools_page_icon-28px.ico",
    "128": "assets/devtools_page_icon.ico"
  },
  "web_accessible_resources": ["assets/devtools_page_icon-28px.ico", "assets/devtools_page_icon.ico"]
}
